<Window x:Class="ConcertTicket.Windows.ConcertDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết concert" Height="560" Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ConcertNameTextBlock" Grid.Row="0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ConcertInfoTextBlock" Grid.Row="1" FontSize="14" Foreground="Gray"
                   Margin="0,6,0,12" TextWrapping="Wrap"/>

        <!-- TODO (Dương): ảnh poster + ảnh sơ đồ khu vực (Image) -->
        <DataGrid x:Name="ZoneDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="ZoneDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Khu" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Giá (VND)" Width="130" Binding="{Binding Price, StringFormat=N0}"/>
                <DataGridTextColumn Header="Còn lại" Width="100" Binding="{Binding Remaining}"/>
                <DataGridTextColumn Header="Cổng" Width="100" Binding="{Binding Gate}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Tải lại" Width="80" Height="30"
                    Margin="12,0,0,0" Click="RefreshButton_Click"/>
            <TextBlock x:Name="BookingStatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="DarkRed" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="Số lượng (1-4):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="QuantityTextBox" Width="60" Height="30" Text="1" VerticalContentAlignment="Center"
                     TextChanged="QuantityTextBox_TextChanged"/>
            <TextBlock x:Name="TotalTextBlock" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,16,0"/>
            <Button x:Name="PayButton" Content="Thanh toán" Width="140" Height="36" Click="PayButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
