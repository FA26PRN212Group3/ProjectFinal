<Window x:Class="ConcertTicket.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Concert Ticket" Height="600" Width="960" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: tên user + đăng xuất -->
        <DockPanel Grid.Row="0">
            <Button x:Name="PaymentHistoryButton" DockPanel.Dock="Right" Content="Lịch sử thanh toán" Height="32"
                    Padding="12,0" Margin="8,0,0,0" Click="PaymentHistoryButton_Click"/>
            <Button x:Name="LogoutButton" DockPanel.Dock="Right" Content="Đăng xuất" Width="100" Height="32"
                    Click="LogoutButton_Click"/>
            <TextBlock x:Name="WelcomeTextBlock" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,8">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <Label Content="Tên concert" Target="{Binding ElementName=SearchTextBox}" Padding="0,0,0,4"/>
                    <TextBox x:Name="SearchTextBox" Width="220" Height="28" MaxLength="200" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Tên concert"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <Label Content="Địa điểm" Target="{Binding ElementName=VenueComboBox}" Padding="0,0,0,4"/>
                    <ComboBox x:Name="VenueComboBox" Width="210" Height="28" AutomationProperties.Name="Địa điểm"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <Label Content="Ngày concert" Target="{Binding ElementName=ConcertDatePicker}" Padding="0,0,0,4"/>
                    <DatePicker x:Name="ConcertDatePicker" Width="145" Height="28" AutomationProperties.Name="Ngày concert"/>
                </StackPanel>
                <Button x:Name="SearchButton" Content="Tìm" Width="80" Height="28" Margin="0,20,0,8"
                        VerticalAlignment="Bottom" IsDefault="True" Click="SearchButton_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ConcertStatusTextBlock" Text="Danh sách concert" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <DataGrid x:Name="ConcertDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="ConcertDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên concert" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Nghệ sĩ" Width="180" Binding="{Binding Artist}"/>
                <DataGridTextColumn Header="Địa điểm" Width="200" Binding="{Binding Venue}"/>
                <DataGridTextColumn Header="Ngày giờ" Width="140" Binding="{Binding StartTime, StringFormat=dd/MM/yyyy HH:mm}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="DetailButton" Grid.Row="3" Content="Xem chi tiết" Width="140" Height="36"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="DetailButton_Click"/>
    </Grid>
</Window>
