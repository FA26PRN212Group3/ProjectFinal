<Window x:Class="ConcertTicket.Windows.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vé của bạn" Height="560" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="0" FontSize="18" FontWeight="Bold"
                   Text="Đang phát hành vé..." TextWrapping="Wrap"/>

        <!-- TODO (Bảo): danh sách vé (mã vé, khu, gate, ảnh QR) -->
        <ListBox x:Name="TicketListBox" Grid.Row="1" Margin="0,12,0,12" DisplayMemberPath="TicketCode"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CalendarStatusTextBlock" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"/>
            <Button x:Name="RetryCalendarButton" Grid.Column="1" Content="Thử lại Calendar" Width="130" Height="36"
                    Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="RetryCalendarButton_Click"/>
            <Button x:Name="OpenCalendarButton" Grid.Column="2" Content="Mở Google Calendar" Width="170" Height="36"
                    IsEnabled="False" Click="OpenCalendarButton_Click"/>
        </Grid>
    </Grid>
</Window>
